# Local development: backend runs separately on port 5000.
VITE_API_ORIGIN=http://localhost:5000

# Production build behind the host Nginx (nginx/default.conf) — same-origin API and /storage:
# VITE_API_ORIGIN=/
# Optional: serve images from a different origin than the API (defaults to ${VITE_API_ORIGIN}/storage).
# VITE_STORAGE_URL=
