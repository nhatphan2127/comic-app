GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-long-random-password

# Backend and application settings
# Nginx serves the frontend and proxies API/storage requests to the private backend service.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8083
VITE_API_ORIGIN=/
DB_PATH=/app/data/comic-platform.sqlite
STORAGE_ROOT=/app/storage
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:8083,http://127.0.0.1:8083,http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:8083
# This local HTTP deployment needs non-Secure cookies; set true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional email delivery. Leave SMTP_HOST empty to keep messages in the local outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Comic platform <no-reply@localhost>"

# Optional request, rate-limit, and bulk-import overrides (defaults shown).
REQUEST_TIMEOUT_MS=1800000
AUTH_RATE_LIMIT=20
COMIC_CREATE_RATE_LIMIT=10
SUGGEST_RATE_LIMIT=60
PUBLISH_BAD_KEY_LIMIT=20
PUBLISH_RATE_LIMIT=60
PUBLISH_BULK_RATE_LIMIT=10
BULK_MAX_ARCHIVE_MB=2048
BULK_MAX_ENTRIES=20000
BULK_MAX_UNCOMPRESSED_MB=4096

# Monitoring stack
GRAFANA_PORT=3017

# Linux deployments: set these to the owner IDs of backend/data and backend/storage.
APP_UID=1000
APP_GID=1000
