# Environment for the Grafana Alloy log agent on the APP server (host install, no Docker).
# Append these lines to /etc/default/alloy (the EnvironmentFile of the alloy systemd unit),
# keeping the package's CONFIG_FILE / CUSTOM_ARGS / RESTART_ON_UPGRADE entries.

# Loki push endpoint on the monitoring server.
LOKI_URL=http://MONITORING_SERVER_IP:3100/loki/api/v1/push
# Added as the `host` label on every log line.
APP_HOSTNAME=comic-app-1
