# Backend runtime settings (host install, loaded by systemd EnvironmentFile or `node --env-file=.env`).
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
DB_PATH=/var/lib/comic-app/data/comic-platform.sqlite
STORAGE_ROOT=/var/lib/comic-app/storage
ADMIN_IMPORT_STAGING_DIR=/var/lib/comic-app/data/admin-import-staging
LOG_DIR=/var/log/comic-app
LOG_LEVEL=info
# Replace with the public origin(s) served by Nginx.
CLIENT_ORIGIN=http://your-domain.example
APP_URL=http://your-domain.example
# Set COOKIE_SECURE=true once the site is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Initial admin account for scripts/setupDatabase.js only.
# Set ADMIN_EMAIL and ADMIN_PASSWORD before running the database setup script.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# S3-compatible storage (SeaweedFS container on the same host, see object-storage/seaweedfs).
STORAGE_DRIVER=s3
STORAGE_BUCKET=comic-images
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://your-domain.example/storage
STORAGE_FORCE_PATH_STYLE=true
# Must match AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the SeaweedFS .env.
AWS_ACCESS_KEY_ID=comic-app-local
AWS_SECRET_ACCESS_KEY=replace-this-local-secret

# Optional email delivery. Leave SMTP_HOST empty to keep messages in the local outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Comic platform <no-reply@localhost>"

# Optional request, rate-limit, and Admin ZIP restore overrides.
REQUEST_TIMEOUT_MS=1800000
AUTH_RATE_LIMIT=20
COMIC_CREATE_RATE_LIMIT=10
SUGGEST_RATE_LIMIT=60
ADMIN_IMPORT_MAX_ENTRIES=20000
ADMIN_IMPORT_MAX_UNCOMPRESSED_MB=4096
ADMIN_IMPORT_SESSION_TTL_HOURS=12
