# Docker Compose settings for the monitoring server (copy to .env).
MONITORING_DATA_DIR=/var/lib/comic-monitoring

# Grafana UI. Use 127.0.0.1 if you only reach it through an SSH tunnel or a local reverse proxy.
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3017

# Loki push API used by the Alloy agent on the app server. Firewall it to the app server IP only.
LOKI_BIND_ADDRESS=0.0.0.0
LOKI_PORT=3100
