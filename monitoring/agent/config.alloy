// Grafana Alloy log agent — runs on the APP server and pushes logs to Loki on the monitoring server.
// Host log directories are mounted read-only by agent/docker-compose.yml:
//   /var/log/comic-app  -> /var/log/comic-app   (backend Winston logs, LOG_DIR)
//   /var/log/nginx      -> /var/log/nginx       (Nginx JSON access log)

local.file_match "comic_app_logs" {
	path_targets = [
		{
			"__path__"     = "/var/log/comic-app/app*.log",
			"job"          = "comic-app-backend",
			"service_name" = "comic-app-backend",
			"log_type"     = "application",
		},
		{
			"__path__"     = "/var/log/comic-app/access*.log",
			"job"          = "comic-app-backend",
			"service_name" = "comic-app-backend",
			"log_type"     = "access",
		},
		{
			"__path__"     = "/var/log/comic-app/audit*.log",
			"job"          = "comic-app-backend",
			"service_name" = "comic-app-backend",
			"log_type"     = "audit",
		},
		{
			"__path__"     = "/var/log/nginx/comic-app.access.log",
			"job"          = "comic-app-nginx",
			"service_name" = "comic-app-nginx",
			"log_type"     = "access",
		},
	]
}

loki.source.file "comic_app_logs" {
	targets    = local.file_match.comic_app_logs.targets
	forward_to = [loki.write.remote.receiver]
}

loki.write "remote" {
	endpoint {
		// e.g. http://10.0.0.20:3100/loki/api/v1/push — set LOKI_URL in agent/.env
		url = sys.env("LOKI_URL")
	}
	external_labels = {
		host = sys.env("APP_HOSTNAME"),
	}
}
