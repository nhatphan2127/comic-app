# Loki push endpoint on the monitoring server.
LOKI_URL=http://MONITORING_SERVER_IP:3100/loki/api/v1/push
# Added as the `host` label on every log line.
APP_HOSTNAME=comic-app-1

# Host directories (defaults match backend/.env LOG_DIR and the Nginx config).
BACKEND_LOG_DIR=/var/log/comic-app
NGINX_LOG_DIR=/var/log/nginx
ALLOY_DATA_DIR=/var/lib/comic-alloy
